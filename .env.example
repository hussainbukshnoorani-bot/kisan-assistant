# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://kisan:kisan@localhost:5432/kisan

# Secret used to hash phone numbers (research R12). Use a long random value.
CONTACT_HASH_PEPPER=

# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# SMS: "fake" prints replies to the log; set to the vendor name once chosen (T008 / T076)
SMS_PROVIDER=fake
# At least 32 characters; part of the inbound SMS webhook URL
SMS_WEBHOOK_SECRET=

# Optional: enables the LLM fallback for understanding messages (Phase 6)
ANTHROPIC_API_KEY=
